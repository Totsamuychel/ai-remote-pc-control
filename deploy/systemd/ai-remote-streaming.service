[Unit]
Description=AI Remote PC Control - Screen Streaming Service
After=network.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/ai-remote-pc-control
EnvironmentFile=-%h/ai-remote-pc-control/.env
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U

# Launch FastAPI Streaming & Web HUD Server
ExecStart=%h/ai-remote-pc-control/agent/.venv/bin/python streaming/server.py --host 0.0.0.0 --port 8080

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
