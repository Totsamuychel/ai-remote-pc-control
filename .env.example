# AI Remote PC Control Environment Variables

# Server Transport & Network
MCP_TRANSPORT=stdio          # "stdio" or "sse"
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_AUTH_TOKEN=your_secure_random_token_here

# Security Policy
SECURITY_MODE=safe-execute   # "read-only", "safe-execute", "full-control"
ALLOWED_DIRECTORIES=/home/Danya,/tmp
REQUIRE_APPROVAL_COMMANDS=true
REQUIRE_APPROVAL_FILES=true

# Audit Logging
AUDIT_LOG_FILE=audit.jsonl
AUDIT_LOG_ENABLED=true
